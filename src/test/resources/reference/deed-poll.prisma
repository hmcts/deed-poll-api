// DeedPoll — caseworker case model.
//
// Ports the Dynamics 365 `deedpoll_deedpoll` entity + child tables to a relational
// model. Option sets are modelled as Prisma enums; the exact Dynamics numeric value
// for each member is preserved in the app-layer label maps (libs/deed-poll/src/enums/),
// so data stays interoperable with a future Dataverse re-import.
//
// `generator` and `datasource` live in base.prisma — this is a multi-file schema
// (Prisma reads every .prisma in this directory) and they may only be declared once.

// ---------------------------------------------------------------------------
// Enums (option sets). Comment on each member = the Dynamics integer value.
// ---------------------------------------------------------------------------

enum DeedPollType {
  Adult // 1
  AdultTransgender // 2
  Minor // 3
  MinorTransgender // 4
  DeedOfRelinquishment // 5
  Unknown // 6
}

enum DeedPollState {
  Received // 1
  ReadyForMaster // 2
  ReferredToMaster // 3
  Enroled // 4
  Returned // 5
  AwaitingFurtherDocs // 6
  AwaitingSignature // 7
  AwaitingEnrolment // 8
}

enum MaritalStatus {
  Single // 1
  MarriedCivilPartnership // 2
  Widowed // 3
  DivorcedDissolved // 4
}

enum Privacy {
  Normal // 1
  Private // 2
}

enum Urgency {
  Normal // 1
  Urgent // 2
}

enum PostCounter {
  Counter // 1
  Online // 2
  Post // 3
  Unknown // 4
}

enum Nationality {
  BritishCitizen // 1
  BritishDependantTerritoriesCitizen // 2
  CommonwealthCitizen // 3
  Unknown // 4
}

enum NationalitySection {
  Section1 // 1
  Section11 // 2
  Section37 // 3
  Section6 // 4
  Unknown // 5
  NoneOfTheAbove // 6
}

enum MasterDecision {
  Approved // 1
  Rejected // 2
}

enum ReferToMaster {
  Yes // 1
  No // 2
}

enum DocumentDirection {
  Incoming // 1
  Outgoing // 2
}

// ---------------------------------------------------------------------------
// Main entity: deedpoll_deedpoll -> DeedPoll
// ---------------------------------------------------------------------------

model DeedPoll {
  id String @id @default(uuid())

  // --- Identity ---
  // referencenumber: serial component of the display reference. Allocated on
  // create by ReferenceNumberService (Phase 3). displayReference is derived,
  // not stored, but persisted here as a unique key for lookups/integrity.
  referencenumber  Int?
  displayReference String? @unique

  // --- General / classification ---
  type                       DeedPollType?
  state                      DeedPollState?
  privacy                    Privacy        @default(Normal)
  urgency                    Urgency        @default(Normal)
  urgencyreason              String?
  postCounter                PostCounter?
  inPerson                   Boolean?
  migratedRecord             Boolean        @default(false)
  retainPermanently          Boolean        @default(false)
  maritalStatus              MaritalStatus?
  feeReference               String?
  onlineApplicationReference String?

  // --- Applicant name (nvarchar 1000) ---
  newForename   String? @db.VarChar(1000)
  newMiddleName String? @db.VarChar(1000)
  newSurname    String? @db.VarChar(1000)
  oldForename   String? @db.VarChar(1000)
  oldMiddleName String? @db.VarChar(1000)
  oldSurname    String? @db.VarChar(1000)

  // --- Applicant address & contact (flat text — no contact/account linkage) ---
  // Field set & names mirror the source entity columns (deedpoll_applicant*).
  applicantBuildingNoName String?
  applicantEmail          String?
  applicantTelephone      String?
  applicantAddress1       String?
  applicantAddress2       String?
  applicantTownCity       String?
  applicantPostcode       String?

  // --- Representative address & contact (flat text) ---
  representativeName         String?
  representativeBuildingNoName String?
  representativeCompany      String?
  representativeAddress1     String?
  representativeEmail        String?
  representativeAddress2     String?
  representativeTelephone    String?
  representativeTownCity     String?
  representativePostcode     String?

  // --- Minor ---
  ageOfMinor       Int?
  ageOfMinorMonths Int?
  minorDateOfBirth DateTime?
  parents          String?

  // --- Public-journey fields -----------------------------------------------------------
  //
  // All NULLABLE, so the caseworker app needs no change and existing rows are unaffected.
  //
  // These exist because the schema is otherwise a faithful port of the Dynamics entity, and the
  // source entity cannot store what a redesigned public-facing application journey needs to
  // capture. Each field below documents the specific gap it closes.
  //
  // Migrations for this schema are owned here, in libs/postgres-prisma.

  /// Country of birth, from a managed register. Required to DERIVE the British Nationality Act
  /// section rather than asking an applicant to self-classify (redesign NAT-7 / MIN-7). Not
  /// collected anywhere in the captured service.
  placeOfBirth String? @db.VarChar(100)

  /// WHOSE citizenship `nationality` and `nationalitySection` describe: 'minor' or 'applicant'.
  /// The captured minor journey records the MINOR's citizenship (confirmed by the service team)
  /// while every hint on those screens says "Applicant" — so the stored value was ambiguous and
  /// a caseworker could not tell which person had been assessed (redesign MIN-6).
  nationalitySubject String? @db.VarChar(20)

  /// How the Act section was arrived at: derived | derived-confirmed | applicant-asserted |
  /// caseworker-determined | awaiting-caseworker. Makes a derivation auditable — if the rule is
  /// later found wrong, provenance identifies exactly which cases were affected (redesign NAT-5).
  nationalitySectionProvenance String? @db.VarChar(30)

  /// The submitting parent's relationship to the minor ("mother", "father", "guardian", or a
  /// stated legal responsibility). The captured service asks for this as free text but has
  /// nowhere to put it — `parents` holds a name only.
  parentRelationship String? @db.VarChar(100)

  /// The submitting parent's address. The minor journey collects one; the schema had no field
  /// for it, so it was being discarded.
  parentAddress1   String? @db.VarChar(100)
  parentAddress2   String? @db.VarChar(100)
  parentTownCity   String? @db.VarChar(100)
  parentPostcode   String? @db.VarChar(10)
  parentCountry    String? @db.VarChar(100)

  /// A second person with parental responsibility. The captured service collects their name and
  /// relationship on a conditional page and then has nowhere to store either.
  secondParentName         String? @db.VarChar(1000)
  secondParentRelationship String? @db.VarChar(100)

  // --- Nationality ---
  nationality             Nationality?
  nationalitySection      NationalitySection?
  nationalitySectionOther String?

  // --- Declarations (multiselect stored as int[] preserving Dynamics values) ---
  iShall            Int[]     @default([]) // 1 wife,2 husband,3 civil partner,4 children,5 I alone
  iHaveSubscribed   Int[]     @default([]) // 1 forename,2 middle,3 surname
  andAlsoMyOld      Int[]     @default([]) // 1 forename,2 middle,3 surname
  dateOfDeclaration DateTime?

  // --- Dates driving state ---
  dateOfApplication             DateTime?
  dateReceived                  DateTime?
  awaitingFurtherDocsInfo       DateTime?
  signatureRequestedDate        DateTime?
  // source column misspelled "recieved"; expose corrected name, map to DB col
  signatureReceivedDate         DateTime? @map("signaturerecieveddate")
  dateReadyForMaster            DateTime?
  dateReferred                  DateTime?
  dateEnroled                   DateTime?
  dateReturned                  DateTime?
  dateNoticeSentToLondonGazette DateTime?

  // --- Master / referral ---
  referToMasterChoice            ReferToMaster?
  masterName                     String?
  masterDirections               String?
  masterDecision                 MasterDecision?
  masterDateOfDecision           DateTime?
  dateDecisionDirectionsReceived DateTime?
  referralNotes                  String?
  publishToLondonGazette         Boolean         @default(true)

  // --- Return / refund ---
  returnReason    String?
  refundAmount    Decimal?  @db.Decimal(12, 2)
  dateOfRefund    DateTime?
  refundReference String?

  // --- Audit ---
  createdOn  DateTime @default(now())
  modifiedOn DateTime @updatedAt

  /// Who created / last modified the record, shown in the case header alongside the
  /// two timestamps (Dynamics "Created By" / "Modified By"). Nullable because rows
  /// predating this column have no attributable author — the header renders
  /// "Not recorded" for them rather than inventing one. Stored as the display name
  /// resolved at write time, not a foreign key: the prototype has no user table, and
  /// a name captured at the time of the write is what the source header shows.
  createdBy  String? @db.VarChar(200)
  modifiedBy String? @db.VarChar(200)

  // --- Relations ---
  notes     DeedPollNote[]
  witnesses DeedPollWitness[]
  documents DeedPollSupportingDocument[]

  @@index([state])
  @@index([type])
  @@index([dateReceived])
  @@map("deedpoll_deedpoll")
}

// ---------------------------------------------------------------------------
// Child entities
// ---------------------------------------------------------------------------

model DeedPollNote {
  id         String   @id @default(uuid())
  deedPollId String
  deedPoll   DeedPoll @relation(fields: [deedPollId], references: [id], onDelete: Cascade)

  note String @db.VarChar(2000)

  // Audit text, mirroring the case's own createdBy/modifiedBy. Nullable so the notes
  // that predate these columns render "Not recorded" rather than "null", and so a
  // caller that sends no x-user-name is never attributed to someone who did not write it.
  createdBy  String? @db.VarChar(200)
  modifiedBy String? @db.VarChar(200)

  createdOn  DateTime @default(now())
  modifiedOn DateTime @updatedAt

  @@index([deedPollId])
  @@map("deedpoll_notes")
}

// The source's `deedpoll_NoteID` (an autonumber display code) is deliberately NOT ported.
// Dataverse forces a GUID primary key on every table, so a short human-readable handle had
// to be a second column; Postgres has no such constraint and `id` is the only identity we
// need. The column existed here, never populated, until 2026-08-10 — its sole reader printed
// "No code" for every note. Decision Steve's: notes are cited by their text, not a number.
// `schema.conformance.spec.ts` records the omission explicitly.

model DeedPollWitness {
  id         String   @id @default(uuid())
  deedPollId String
  deedPoll   DeedPoll @relation(fields: [deedPollId], references: [id], onDelete: Cascade)

  witnessName       String  @db.VarChar(100)
  witnessAddress    String  @db.VarChar(250)
  witnessOccupation String  @db.VarChar(100)
  declarant         Boolean // Yes/No — flags declarant vs witness

  createdOn  DateTime @default(now())
  modifiedOn DateTime @updatedAt

  @@index([deedPollId])
  @@map("deedpoll_witness")
}

model DeedPollSupportingDocumentType {
  id   String @id @default(uuid())
  name String @db.VarChar(100)

  // multiselect option-set values preserved as int[]
  applicableMaritalStatuses Int[] @default([])
  applicableTypes           Int[] @default([])

  documents DeedPollSupportingDocument[]

  @@map("deedpoll_supportingdocumenttype")
}

// ---------------------------------------------------------------------------
// Reference-number allocation (Phase 3)
//
// The Dynamics flow allocated the per-year serial by reading the current max
// reference number and adding one, which races under concurrent creates. We
// replace that with a per-year counter row incremented inside a transaction
// (SELECT … FOR UPDATE), so serial allocation is atomic — a deliberate
// correctness improvement over the source flow. The serial is shared across
// both KBDP and KBDR within a year, so the counter is keyed by year alone.
// ---------------------------------------------------------------------------
model ReferenceCounter {
  year        Int @id
  lastSerial  Int @default(0)

  @@map("deedpoll_referencecounter")
}

model DeedPollSupportingDocument {
  id         String   @id @default(uuid())
  deedPollId String
  deedPoll   DeedPoll @relation(fields: [deedPollId], references: [id], onDelete: Cascade)

  direction      DocumentDirection
  name           String                         @db.VarChar(100)
  documentTypeId String
  documentType   DeedPollSupportingDocumentType @relation(fields: [documentTypeId], references: [id])

  // File reference — blob stored on disk/object storage (Phase 10); metadata here.
  storageKey   String?
  originalName String?
  mimeType     String?
  sizeBytes    Int?

  createdOn  DateTime @default(now())
  modifiedOn DateTime @updatedAt

  @@index([deedPollId])
  @@map("deedpoll_supportingdocument")
}
