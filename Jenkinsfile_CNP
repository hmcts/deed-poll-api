#!groovy

// Pinned, and pinned to the same version as deed-poll-admin and deed-poll-web: an unpinned
// `@Library("Infrastructure")` tracks the library's default branch, so the deploy behaviour of all
// four repos could change between two runs with no commit here. Bump the set together.
@Library("Infrastructure@2.12.2") _

import uk.gov.hmcts.contino.GradleBuilder

def type = "java"
def product = "deed-poll"
def component = "api"

// The library's own Gradle invocation (its init script included), as pcs-api uses for the definition generator.
GradleBuilder builder = new GradleBuilder(this, product)

withPipeline(type, product, component) {
  // The environment's Ubuntu agent image supplies Docker and grants jenkinsssh access. Include
  // PostgreSQL-backed tests on PR and master builds so Sonar receives their coverage.
  env.INTEGRATION_TESTS_ENABLED = "true"
  env.TESTCONTAINERS_HUB_IMAGE_NAME_PREFIX = "hmctsprod.azurecr.io/imported/"

  before('test') {
    sh label: 'Check Docker access for PostgreSQL tests', script: 'docker info --format "{{.ServerVersion}}"'
  }

  // The shared library publishes the test source set; publish integration results here as well.
  afterAlways('test') {
    junit testResults: '**/test-results/integration/*.xml', allowEmptyResults: true
  }

  // CCD definition import, through the library's "High Level Data Setup" stage as pcs-api imports its own.
  // See docs/plans/20261021-ccd-high-level-data-setup.md.
  //
  // Master imports into AAT on every build, ahead of the AAT deploy. The second argument skips the prod stage
  // (`skipHighLevelDataSetupProd`): prod's import waits for its IDAM importer user and CCD routing (P7), and then
  // this flag is removed, so every later master build re-imports into AAT and then prod, as pcs-api's does.
  // An import of an unchanged definition only adds a definition version; existing cases are unaffected.
  onMaster {
    // Nothing else sets ENVIRONMENT before the AAT import; `before('Publish Helm chart')` below moves it on to
    // prod, which runs after the AAT deploy and before the prod stage. It names the spreadsheet create-xlsx.sh
    // writes and the importer reads.
    env.ENVIRONMENT = 'aat'
    enableHighLevelDataSetup('', true)
  }

  onIthc {
    // Nothing sets ENVIRONMENT before the import stage on an ithc build (pcs-api sets it the same way). It names the
    // spreadsheet create-xlsx.sh writes and the importer reads.
    env.ENVIRONMENT = 'ithc'
    enableHighLevelDataSetup()
  }

  before('highleveldatasetup') {
    generateDefinitions(builder)
  }

  // The chart is published between the AAT deploy and the prod stage, so the prod import (once enabled) builds
  // CCD_Definition_DEEDPOLL_prod.xlsx rather than AAT's.
  before('Publish Helm chart') {
    onMaster {
      env.ENVIRONMENT = 'prod'
    }
  }
}

def generateDefinitions(builder) {
  // The three identifiers the definition is generated with, as docs/CCD-SMOKE.md generates it.
  withEnv(['CCD_CASE_TYPE_ID=DEEDPOLL', 'CCD_JURISDICTION_ID=DEEDPOLL', 'CCD_SYSTEM_ROLE=deed-poll-system-update']) {
    builder.gradle('--rerun-tasks generateCCDConfig')
  }
  sh "./bin/create-xlsx.sh ${env.ENVIRONMENT}"
  archiveArtifacts artifacts: 'build/definitions/*.xlsx'
}
