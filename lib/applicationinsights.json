{
  "connectionString": "${file:/mnt/secrets/deed-poll/app-insights-connection-string}",
  "role": {
    "name": "deed-poll-api"
  },
  "sampling": {
    "overrides": [
      {
        "telemetryType": "request",
        "attributes": [
          {
            "key": "http.url",
            "value": "https?://[^/]+/health.*",
            "matchType": "regexp"
          }
        ],
        "percentage": 1
      }
    ]
  },
  "preview": {
    "processors": [
      {
        "type": "attribute",
        "actions": [
          {
            "key": "url.query",
            "action": "delete"
          },
          {
            "key": "url.full",
            "pattern": "^(?<base>[^?#]*)[?#].*$",
            "replace": "${base}?REDACTED",
            "action": "mask"
          },
          {
            "key": "http.url",
            "pattern": "^(?<base>[^?#]*)[?#].*$",
            "replace": "${base}?REDACTED",
            "action": "mask"
          }
        ]
      }
    ]
  }
}
